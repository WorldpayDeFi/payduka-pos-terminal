# PayDuka PoS Terminal — Environment Variables
# Copy this file to .env and fill in your values
# On Replit, set these as Secrets in the project settings

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL direct connection string
# Find it: Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase (frontend) ───────────────────────────────────────────────────────
# Find both at: Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── PowerSync (offline sync) ──────────────────────────────────────────────────
# Create an instance at: app.powersync.com → connect to your Supabase DB
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# ── AI Agent ─────────────────────────────────────────────────────────────────
# Used by the AI Agent page for business insights
OPENAI_API_KEY=sk-...

# ── Payments ─────────────────────────────────────────────────────────────────
# Yoco card payments (South Africa) — get from developer.yoco.com
YOCO_SECRET_KEY=sk_live_...

# ── Blockchain ───────────────────────────────────────────────────────────────
# Polygon network scanner API key — get from polygonscan.com
POLYGONSCAN_API_KEY=your-key-here

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=generate-a-random-32-char-string-here
